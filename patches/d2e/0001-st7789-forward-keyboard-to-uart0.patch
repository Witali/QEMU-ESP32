+int esp32_uart_receive_bytes(ESP32UARTState *s, const uint8_t *buf, int size)
+{
+    int accepted;
+
+    if (!s || !buf || size <= 0) {
+        return 0;
+    }
+
+    accepted = MIN(size, uart_can_receive(s));
+    uart_receive(s, buf, accepted);
+    return accepted;
+}
