 {
     BusState *b = BUS(bus);
     BusChild *kid;
     uint32_t r = 0;
+    bool selected = false;
 
     QTAILQ_FOREACH(kid, &b->children, sibling) {
         SSIPeripheral *p = SSI_PERIPHERAL(kid->child);
+
+        /*
+         * A custom transfer_raw implementation controls chip selection
