+            (!p->cs && p->spc->cs_polarity == SSI_CS_LOW) ||
+            p->spc->cs_polarity == SSI_CS_NONE;
         r |= p->spc->transfer_raw(p, val);
     }
 
-    return r;
+    return selected ? r : bus->idle_value;
 }
 
